# ========== LLM API (用于意图识别和对话) ==========
GROQ_API_KEY="Some token for GROQ API"
LLM_MODEL="Your LLM model name, e.g., llama-3.3-70b"

# ---------- LLM cost pricing (optional; for the admin token-consumption card) ----------
# Token counts are always recorded; cost is $0 until priced. USD per 1,000,000 tokens.
# LLM_PRICE_INPUT_PER_1M="0"
# LLM_PRICE_OUTPUT_PER_1M="0"
# Optional per-model overrides (JSON); falls back to the globals above:
# LLM_PRICE_TABLE_JSON='{"gpt-4o": {"input": 2.5, "output": 10}}'

# ========== Tool Provider Credentials ==========
# SerpAPI is used by restaurant Google Maps/Yelp tools, the hotel Google Maps
# search, and product Amazon search.
SERPAPI_KEY="Some token for SerpAPI"
SERPAPI_URL="SerpAPI URL, e.g., https://serpapi.com/search.json"

# Hotel OpenStreetMap discovery (Nominatim geocoding + Overpass lodging lookup)
# requires no credentials.

# TikHub is used by the Xiaohongshu restaurant/source search tools.
TIKHUB_API_KEY="Some token for TIKHUB API"

# Hardcover is used by book recommendation search.
HARDCOVER_API_KEY="Some token for Hardcover API"

# TMDB v4 API access token is used by movie/TV search and discovery tools.
# Use the API Read Access Token, not the v3 API key.
TMDB_API_ACCESS_TOKEN="Some TMDB API read access token"

# MusicBrainz recording search/discover and Cover Art Archive enrichment do not require credentials.
# OpenLibrary book discovery (author/publisher/subject) does not require credentials.

# Last.fm powers popularity-ranked music discovery (top tracks by artist or genre).
# Optional: the lastfm.track.discover tool self-skips when this is unset.
LASTFM_API_KEY="Some token for Last.fm API"

# ========== 302 API 配置（可选，如果需要使用302 API） ==========
API_302_KEY="Some token for 302 API"

# Public browser token for Mapbox GL rendering. Restrict it by deployment URL.
VITE_MAPBOX_TOKEN="Some mapbox key"
# Backend token for Mapbox Directions outside Singapore / OneMap fallback.
# Keep this in server secrets; VITE_MAPBOX_TOKEN remains a compatibility fallback.
MAPBOX_ACCESS_TOKEN="Some server-side mapbox key"

# ========== Itinerary leg ETAs (OneMap, optional) ==========
# Singapore walk / public-transport routing with fares. Free account at
# https://www.onemap.gov.sg/. Without these, legs fall back to Mapbox
# Directions, then to deterministic estimates.
ONEMAP_EMAIL="OneMap account email"
ONEMAP_PASSWORD="OneMap account password"
# Solver-neutral adapter selector. Only "beam" is supported today; future
# MILP/DSL adapters must consume the same Planning IR before being enabled.
ITINERARY_SOLVER="beam"
# Task-scoped adaptive retrieval safety bounds. Values are clamped server-side
# to 1-24 provider calls and 1-3 rounds.
ITINERARY_MAX_PROVIDER_CALLS="8"
ITINERARY_MAX_RETRIEVAL_ROUNDS="2"

# ========== Restaurant agent planner/summarizer models (optional) ==========
# The restaurant planner/summarizer uses the OpenAI-compatible LLM above
# (LLM_BASE_URL / LLM_API_KEY / LLM_MODEL) by default. Override its models here
# (both default to LLM_MODEL; the planning model must support tool calling).
# AGENT_PLANNING_MODEL="llama-3.3-70b-versatile"
# AGENT_SUMMARY_MODEL="llama-3.3-70b-versatile"
# Request timeout for the planner/summarizer client (large payloads; default 120s)
# AGENT_LLM_TIMEOUT_SECONDS="120"

# ========== Azure OpenAI (可选，仅作回退 / optional fallback) ==========
# Used for the restaurant planner/summarizer only when no OpenAI-compatible
# API key (LLM_API_KEY / GROQ_API_KEY) is configured.
# OPENAI_API_KEY="Some azure token"
# AZURE_OPENAI_ENDPOINT="Some Azure OpenAI endpoint, e.g., https://your-resource-name.openai.azure.com/"
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ========== Database (PostgreSQL, required) ==========
DATABASE_URL="postgresql://metarec:metarec@localhost:5432/metarec?sslmode=disable"

# ========== Admin / Roles ==========
# Comma-separated emails auto-promoted to the `admin` role on startup (idempotent).
# Admins are also bootstrappable via scripts/seed_admin.py or direct SQL.
METAREC_ADMIN_EMAILS="admin@example.com"

# ========== Debug Layer Configs ==========
# DEBUG_UI_ENABLED is the master kill-switch for the /internal/debug API. Access
# additionally requires a real authenticated user with the `admin` role — the old
# DEBUG_ADMIN_TOKEN / DEBUG_SESSION_* shared-token auth has been removed.
DEBUG_UI_ENABLED=true
DEBUG_LLM_EXPLAIN_ENABLED=true
